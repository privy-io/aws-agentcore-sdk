# Copy to .env.local and fill in.
#
# The first three come from https://dashboard.privy.io/apps/<your-app>/settings
# plus "Wallet infrastructure → Authorization keys" for the signer ID.
#
# Public — fine to expose in the browser bundle
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only — never ship to the browser
PRIVY_APP_SECRET=
# Public identifier of the key quorum AgentCore uses on behalf of users
NEXT_PUBLIC_PRIVY_SIGNER_ID=

# ─── Network mode ─────────────────────────────────────────────────────────
#
# Required. Controls which chains the app reads balances from, which chains
# external-wallet transfers target, and whether card funding (Stripe onramp)
# is enabled.
#
#   mainnet  — Base mainnet (chain id 8453) + Solana mainnet-beta.
#              Card funding via Stripe is enabled. (Default if unset.)
#   testnet  — Base Sepolia (chain id 84532) + Solana Devnet.
#              Card funding is disabled (Stripe onramp is mainnet-only).
#
# Most agent developers working against AWS AgentCore Payments preview
# environments should start in `testnet` and switch to `mainnet` for
# production deployments.
NEXT_PUBLIC_NETWORK_MODE=testnet

# Fiat funding environment — production (default) or sandbox.
# Sandbox simulates purchases using MAINNET chain identifiers; it does not
# fund Base Sepolia/Solana Devnet or credit real on-chain balances.
# To test card funding, use NETWORK_MODE=mainnet and this value=sandbox.
NEXT_PUBLIC_FIAT_ONRAMP_ENVIRONMENT=production
